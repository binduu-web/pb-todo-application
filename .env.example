# Supabase Client Configuration (Public Browser Keys Only)
# Find these in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"

# IMPORTANT: Never expose your Supabase service_role key in the frontend or prefix it with VITE_.

# Optional Platform Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
